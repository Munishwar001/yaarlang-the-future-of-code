
maan_lo age = 20

agar age >= 18 {
  bol 'Bada ho gaya'
} nahito {
  bol 'Abhi chhota hai'
}


maan_lo i = 1
jabtak i <= 5 {
  bol i 
  i = i + 1
}


kaam add(a, b) {
  wapis a + b
}
bol add(3, 4)


maan_lo nums = [10, 20, 30]
