{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YaarLang",
  "scopeName": "source.yaarlang",
  "fileTypes": ["yl"],
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.yaarlang",
          "match": "\\b(maan_lo|bol|agar|nahito)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yaarlang",
          "begin": "\"",
          "end": "\"",
          "patterns": []
        },
        {
          "name": "string.quoted.single.yaarlang",
          "begin": "'",
          "end": "'",
          "patterns": []
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.yaarlang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.yaarlang",
          "match": "==|!=|<=|>=|&&|\\|\\||[=+\\-*/<>]"
        }
      ]
    }
  }
}
